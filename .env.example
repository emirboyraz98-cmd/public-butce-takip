DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

AUTH_SECRET="generate-with-npx-auth-secret"

# Günlük fiyat/kur tazeleme görevini korur (vercel.json içindeki cron).
# ZORUNLU: tanımlı değilse /api/cron/refresh-prices tüm istekleri reddeder ve
# fiyatlar güncellenmez. Vercel, bu değişken tanımlıysa cron isteğine
# "Authorization: Bearer <değer>" başlığını kendisi ekler.
# Üretmek için: openssl rand -base64 32
CRON_SECRET=""

# İsteğe bağlı. Kur için birincil kaynak TCMB/Frankfurter; bu anahtar yalnızca
# exchangerate.host'a düşüldüğünde kullanılır, boş bırakılabilir.
EXCHANGERATE_HOST_API_KEY=""
